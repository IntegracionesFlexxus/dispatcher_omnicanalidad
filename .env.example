# ========== SERVIDOR ==========
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# ========== ALMACENAMIENTO ==========
# Almacenamiento en MEMORIA (sin Redis)
# Los datos se pierden al reiniciar
# Para instalar Redis: ver docs/GUIA_REDIS.md

# ========== WHATSAPP ==========
WHATSAPP_TOKEN=EAAxxxxx...tu_token_aqui
PHONE_NUMBER_ID=123456789012345
VERIFY_TOKEN=mi_token_secreto_seguro_12345
# App Secret para verificar firma de webhooks (X-Hub-Signature-256)
# Obtenerlo desde: Facebook App Dashboard > App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=tu_app_secret_aqui
# Template para reabrir ventana de 24hs (re-engagement)
# Nombre del template aprobado en Meta Business. Si no se configura, los mensajes
# fuera de ventana se envían sin template y Meta los rechazará con error 131047.
WHATSAPP_REENGAGEMENT_TEMPLATE=
WHATSAPP_REENGAGEMENT_LANGUAGE=es

# ========== APLICACIONES ==========
# Formato: KEY=nombre|url|prioridad
BOT_APP=BOT|http://localhost:4800/webhook|1
ASESOR_APP=SOFTWARE_ASESORES|http://localhost:3001/api/external|2
ENCUESTADOR_APP=ENCUESTADOR|http://localhost:5060/api/dispatcher/incoming|3

# Para agregar más apps:
# VENTAS_APP=VENTAS|http://localhost:5000|4
# SOPORTE_APP=SOPORTE|http://localhost:6000|5

# ========== ENCUESTADOR ==========
# URL base para consultar estado de encuesta (GET /status/{phone})
ENCUESTADOR_STATUS_URL=http://localhost:5060/api/dispatcher/status
# Timeout en ms para la consulta de estado al encuestador (no bloquear el flujo principal)
ENCUESTADOR_STATUS_TIMEOUT_MS=3000
# API Key opcional. Si está seteada, el dispatcher la envía como X-API-Key
# en las llamadas a ENCUESTADOR_STATUS_URL.
ENCUESTADOR_API_KEY=
# TTL en segundos del routing en Redis para encuestador. Cada mensaje renueva
# este TTL. Default: 600 (10 minutos). Min: 60. Max: 86400 (24h).
ENCUESTADOR_ROUTING_TTL_SECONDS=600
# TTL en segundos del cooldown post-encuesta. Tras finalizarEncuesta el
# dispatcher ignora mensajes durante este tiempo para evitar que el bot
# dispare un saludo desde cero. Default: 600 (10 minutos).
ENCUESTADOR_COOLDOWN_TTL_SECONDS=600

# ========== DEDUPLICACIÓN DE WEBHOOKS ==========
# TTL en segundos del cache de wamid procesados. Si Meta o un proxy reenvían
# el mismo webhook (mismo wamid) dentro de este tiempo, se ignora el duplicado.
# Default: 300 (5 minutos).
WEBHOOK_DEDUP_TTL_SECONDS=300

# ========== SEGURIDAD ==========
# API Key para autenticar las apps (opcional, pero RECOMENDADO en producción)
# Generar con: openssl rand -base64 32
API_KEY=LO_QUE_QUIERAS

# CORS - Orígenes permitidos (solo en producción)
# En desarrollo se permiten todos los orígenes
# En producción sin ALLOWED_ORIGINS, se bloquean navegadores (solo server-to-server)
# Formato: URLs separadas por comas
# Ejemplo: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ========== LOGS ==========
LOG_LEVEL=info
LOG_FILE=logs/dispatcher.log

# ========== TIMEOUTS ==========
APP_TIMEOUT_MS=10000
WHATSAPP_TIMEOUT_MS=5000
REDIS_TIMEOUT_MS=2000

# ========== CIRCUIT BREAKER ==========
CIRCUIT_BREAKER_TIMEOUT_MS=10000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
