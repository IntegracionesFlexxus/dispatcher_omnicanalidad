# ========== SERVIDOR ==========
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# ========== ALMACENAMIENTO ==========
# Almacenamiento en MEMORIA (sin Redis)
# Los datos se pierden al reiniciar
# Para instalar Redis: ver docs/GUIA_REDIS.md

# ========== WHATSAPP ==========
WHATSAPP_TOKEN=EAAxxxxx...tu_token_aqui
PHONE_NUMBER_ID=123456789012345
VERIFY_TOKEN=mi_token_secreto_seguro_12345
# App Secret para verificar firma de webhooks (X-Hub-Signature-256)
# Obtenerlo desde: Facebook App Dashboard > App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=tu_app_secret_aqui

# ========== APLICACIONES ==========
# Formato: KEY=nombre|url|prioridad
BOT_APP=BOT|http://localhost:4800/webhook
ASESOR_APP=SOFTWARE_ASESORES|http://localhost:3001/api/external

# Para agregar más apps:
# VENTAS_APP=VENTAS|http://localhost:5000|3
# SOPORTE_APP=SOPORTE|http://localhost:6000|4

# ========== SEGURIDAD ==========
# API Key para autenticar las apps (opcional, pero RECOMENDADO en producción)
# Generar con: openssl rand -base64 32
API_KEY=LO_QUE_QUIERAS

# CORS - Orígenes permitidos (solo en producción)
# En desarrollo se permiten todos los orígenes
# En producción sin ALLOWED_ORIGINS, se bloquean navegadores (solo server-to-server)
# Formato: URLs separadas por comas
# Ejemplo: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ========== LOGS ==========
LOG_LEVEL=info
LOG_FILE=logs/dispatcher.log

# ========== TIMEOUTS ==========
APP_TIMEOUT_MS=10000
WHATSAPP_TIMEOUT_MS=5000
REDIS_TIMEOUT_MS=2000

# ========== CIRCUIT BREAKER ==========
CIRCUIT_BREAKER_TIMEOUT_MS=10000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
